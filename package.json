{
  "name": "provenant-rugs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-of-a-kind hand-knotted Turkish rugs. Static Astro storefront on Cloudflare Pages with Pages Functions for commerce.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate-catalog && npm run certificate -- --all && astro build",
    "preview": "wrangler pages dev ./dist --compatibility-date=2026-09-01",
    "check": "astro check && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y",
    "lhci": "lhci autorun",
    "validate-catalog": "node scripts/validate-catalog.mjs",
    "new-rug": "node scripts/new-rug.mjs",
    "pull-airtable": "node scripts/pull-airtable.mjs",
    "pull-reviews": "node scripts/pull-reviews.mjs",
    "jev:catalog": "node scripts/jev-catalog-check.mjs",
    "certificate": "node scripts/certificate.mjs",
    "upload-media": "node scripts/upload-media.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "budget": "node scripts/check-budgets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "lucide-static": "^1.48.0",
    "marked": "^18.0.14",
    "minisearch": "^7.2.0",
    "stripe": "^22.6.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.5.4",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
