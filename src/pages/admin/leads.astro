---
import AdminLayout from '@/layouts/AdminLayout.astro';
const tabs = [
  ['waitlist', 'Waitlist'],
  ['requests', 'Requests'],
  ['trade', 'Trade applications'],
  ['notify', 'Notify me'],
  ['rooms', 'Room photos'],
  ['contact', 'Contact'],
  ['returns', 'Returns'],
];
---

<AdminLayout title="Waitlist & leads">
  <div role="tablist" aria-label="Lead tables" class="flex flex-wrap gap-1 border-b border-line">
    {tabs.map(([k, l], i) => (
      <button
        role="tab"
        type="button"
        aria-selected={i === 0 ? 'true' : 'false'}
        data-tab={k}
        class="-mb-px border-b-2 border-transparent px-3 py-2 text-small font-medium text-stone aria-selected:border-madder aria-selected:text-indigo"
      >
        {l}
      </button>
    ))}
  </div>
  <p class="mt-3 text-small">
    <a href="#" data-csv>
      Export CSV
    </a>
  </p>
  <div class="mt-3 overflow-x-auto" role="tabpanel">
    <table class="w-full text-small">
      <thead></thead>
      <tbody></tbody>
    </table>
  </div>
  <script>
    let table = 'waitlist';
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    /** Advisory Jev column (docs/JEV.md): one short line, no decisions taken from it here. */
    const jevCell = (raw: unknown) => {
      if (typeof raw !== 'string') return '';
      try {
        const j = JSON.parse(raw) as {
          answers?: Record<
            string,
            { choice?: string; score?: number; noul?: number; probabilities?: number[] }
          >;
        };
        return Object.entries(j.answers ?? {})
          .map(([k, a]) =>
            a.choice !== undefined
              ? `${k}: ${a.choice}`
              : a.score !== undefined
                ? `${k}: ${a.score.toFixed(1)}/${a.probabilities?.length ?? '?'}`
                : `${k}: ${Number(a.noul).toFixed(2)}`,
          )
          .join(' · ');
      } catch {
        return '';
      }
    };
    const thead = document.querySelector('thead')!;
    const tbody = document.querySelector('tbody')!;
    const csv = document.querySelector<HTMLAnchorElement>('[data-csv]')!;
    async function load() {
      csv.href = `/api/admin/leads?table=${table}&format=csv`;
      const r = await fetch(`/api/admin/leads?table=${table}`).then(
        (x) => x.json() as Promise<{ rows: Array<Record<string, unknown>> }>,
      );
      if (!r.rows.length) {
        thead.innerHTML = '';
        tbody.innerHTML = '<tr><td class="py-4 text-stone">Nothing here yet.</td></tr>';
        return;
      }
      const cols = Object.keys(r.rows[0]!);
      thead.innerHTML = `<tr class="border-b border-line text-left">${cols.map((c) => `<th class="py-2 pr-3">${c}</th>`).join('')}${table === 'trade' ? '<th>Approve</th>' : ''}</tr>`;
      tbody.innerHTML = r.rows
        .map(
          (row) =>
            `<tr class="border-b border-line align-top">${cols.map((c) => `<td class="py-2 pr-3">${c === 'photo_url' ? `<a href="${esc(row[c])}" target="_blank" rel="noopener">view photo</a>` : c === 'jev' ? esc(jevCell(row[c])) : esc(String(row[c] ?? '').slice(0, 160))}</td>`).join('')}${table === 'trade' ? `<td><input placeholder="promo code" data-promo class="w-28 rounded-input border border-line px-1" /> <button type="button" data-approve="${row.id}" class="rounded-btn border border-line px-2 py-1">Approve</button> <button type="button" data-reject="${row.id}" class="rounded-btn border border-line px-2 py-1">Reject</button></td>` : ''}</tr>`,
        )
        .join('');
    }
    document.querySelectorAll<HTMLButtonElement>('[role=tab]').forEach((b) =>
      b.addEventListener('click', () => {
        document
          .querySelectorAll('[role=tab]')
          .forEach((t) => t.setAttribute('aria-selected', String(t === b)));
        table = b.dataset.tab!;
        void load();
      }),
    );
    tbody.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const id = t.dataset.approve ?? t.dataset.reject;
      if (!id) return;
      const promo = t.parentElement?.querySelector<HTMLInputElement>('[data-promo]')?.value;
      await fetch('/api/admin/leads', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          table: 'trade',
          id: Number(id),
          status: t.dataset.approve ? 'approved' : 'rejected',
          promo_code: promo || undefined,
        }),
      });
      (window as unknown as { adminSay: (m: string) => void }).adminSay(
        `Application ${id} ${t.dataset.approve ? 'approved — create the Stripe promotion code and email it' : 'rejected'}.`,
      );
      void load();
    });
    void load();
  </script>
</AdminLayout>
