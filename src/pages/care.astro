import ContentLayout from '@/layouts/ContentLayout.astro';
const toc = [
  { id: 'vacuuming', label: 'Vacuuming' },
  { id: 'rotation', label: 'Rotation & sun' },
  { id: 'spills', label: 'Spills' },
  { id: 'cleaning', label: 'Professional cleaning' },
