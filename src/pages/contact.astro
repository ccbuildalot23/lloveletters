---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, telLink, whatsappLink } from '@lib/site';
---

<BaseLayout
  title="Contact · text, call, or write"
  description="Text or WhatsApp, call, email, or book a video call. US-based, and I answer."
>
  <div class="container-content pt-6 pb-24">
    <Breadcrumbs items={[{ label: 'Contact' }]} />
    <div class="mt-4 grid gap-12 lg:grid-cols-[360px_1fr]">
      <header>
        <h1>Talk to a person.</h1>
        <p class="mt-3 text-body-lg text-stone">Me, specifically. Fastest is a text.</p>
        <ul class="mt-6 flex flex-col gap-3 text-body">
          <li class="flex items-center gap-3">
            <Icon name="whatsapp" size={24} class="text-madder" />
            <a href={whatsappLink('Hi Chris,')} rel="noopener">
              WhatsApp / text {site.phone}
            </a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="phone" size={24} class="text-madder" />
            <a href={telLink}>{site.phone}</a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="mail" size={24} class="text-madder" />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="calendar" size={24} class="text-madder" />
            <a href="/book">Book a live video look</a>
          </li>
        </ul>
        <address class="mt-8 text-small text-stone not-italic">
          <strong class="text-charcoal">{site.dealerName}</strong>
          <br />
          {site.address}
          <br />
          Hours: Mon–Fri 9–6 ET, and usually later.
        </address>
      </header>
      <section aria-labelledby="form-title" class="rounded-card border border-line bg-white p-6">
        <h2 id="form-title" class="text-h4">
          Send a message
        </h2>
        <div class="mt-4">
          <ContactForm />
        </div>
      </section>
    </div>
  </div>
  <script>
    const rug = new URLSearchParams(location.search).get('rug');
    if (rug)
      (document.querySelector('input[name=rug_id]') as HTMLInputElement | null)?.setAttribute(
        'value',
        rug.toUpperCase(),
      );
  </script>
</BaseLayout>
