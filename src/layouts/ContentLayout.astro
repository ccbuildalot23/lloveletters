---
/** Long-form content page: breadcrumbs, H1, intro, optional sticky TOC (desktop), last-updated, prose. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
interface Props {
  title: string;
  description: string;
  h1?: string;
  intro?: string;
  updated?: string;
  toc?: Array<{ id: string; label: string }>;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  wide?: boolean;
}
const {
  title,
  description,
  h1 = title,
  intro,
  updated,
  toc = [],
  jsonLd = [],
  noindex = false,
  wide = false,
} = Astro.props;
const crumb = { label: h1, href: Astro.url.pathname };
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} noindex={noindex}>
  <div class="container-content pt-6 pb-24">
    <Breadcrumbs items={[crumb]} />
    <header class="mt-4 mb-10 max-w-3xl">
      <h1>{h1}</h1>
      {intro && <p class="mt-3 text-body-lg text-stone">{intro}</p>}
      {updated && (
        <p class="mt-2 text-caption text-stone">
          Last updated{' '}
          <time datetime={updated}>
            {new Date(updated).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </p>
      )}
    </header>
    <div class={`grid gap-10 ${toc.length ? 'lg:grid-cols-[240px_1fr]' : ''}`}>
      {toc.length > 0 && (
        <nav
          aria-label="On this page"
          class="lg:sticky lg:top-[calc(var(--header-h-compact)+16px)] lg:self-start"
        >
          <p class="mb-2 text-caption font-semibold tracking-wide text-stone uppercase">
            On this page
          </p>
          <ol class="flex flex-col gap-1 border-l border-line">
            {toc.map((t) => (
              <li>
                <a
                  href={`#${t.id}`}
                  class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-small text-charcoal no-underline hover:border-madder hover:text-madder"
                >
                  {t.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <div class={wide ? '' : 'prose-brand text-body-lg'}>
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
