---
interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  align?: 'left' | 'center';
  level?: 1 | 2 | 3;
  class?: string;
  id?: string;
}
const { title, eyebrow, intro, align = 'left', level = 2, class: className = '', id } = Astro.props;
const H = `h${level}` as 'h1' | 'h2' | 'h3';
---

<div class={`section-header mb-8 ${align === 'center' ? 'mx-auto text-center' : ''} ${className}`}>
  {eyebrow && (
    <p class="mb-2 text-small font-medium tracking-wide text-madder uppercase">{eyebrow}</p>
  )}
  <H id={id}>{title}</H>
  {intro && (
    <p class={`mt-3 text-body-lg text-stone ${align === 'center' ? 'mx-auto' : ''}`}>{intro}</p>
  )}
  <slot />
</div>
