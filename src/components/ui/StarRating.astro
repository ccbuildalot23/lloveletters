---
/** Star rating, 0–5 with halves. Always includes a text alternative. */
interface Props {
  rating: number;
  count?: number;
  size?: 16 | 20;
  class?: string;
}
const { rating, count, size = 16, class: className = '' } = Astro.props;
const r = Math.max(0, Math.min(5, rating));
const label = `${r.toFixed(1)} out of 5 stars${count !== undefined ? ` from ${count} reviews` : ''}`;
---

<span
  class={`star-rating inline-flex items-center gap-1 ${className}`}
  role="img"
  aria-label={label}
>
  {[1, 2, 3, 4, 5].map((i) => {
    const fill = Math.max(0, Math.min(1, r - (i - 1)));
    return (
      <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="text-saffron">
        <defs>
          <linearGradient id={`g-${i}-${fill}`}>
            <stop offset={`${fill * 100}%`} stop-color="currentColor" />
            <stop offset={`${fill * 100}%`} stop-color="transparent" />
          </linearGradient>
        </defs>
        <path
          d="M12 2.5l2.9 6.2 6.8.8-5 4.7 1.3 6.7L12 17.6 6 20.9l1.3-6.7-5-4.7 6.8-.8z"
          fill={`url(#g-${i}-${fill})`}
          stroke="currentColor"
          stroke-width="1.2"
        />
      </svg>
    );
  })}
  {count !== undefined && <span class="tnum ml-1 text-small text-stone">({count})</span>}
</span>
