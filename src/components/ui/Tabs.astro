---
/**
 * Accessible tabs (ARIA tablist, arrow-key navigation). Content is rendered for all
 * tabs; without JS, all panels show stacked with headings.
 * Props: tabs [{id, label, content(html)}]
 */
interface Props {
  tabs: Array<{ id: string; label: string; content: string }>;
  class?: string;
}
const { tabs, class: className = '' } = Astro.props;
const uid = `tabs-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`tabs ${className}`} data-tabs id={uid}>
  <div
    role="tablist"
    class="flex gap-1 overflow-x-auto border-b border-line no-scrollbar"
    aria-label="Sections"
  >
    {tabs.map((t, i) => (
      <button
        role="tab"
        id={`${uid}-tab-${t.id}`}
        aria-controls={`${uid}-panel-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        type="button"
        class="tab -mb-px whitespace-nowrap border-b-2 border-transparent px-4 py-3 text-body font-medium text-stone hover:text-indigo aria-selected:border-madder aria-selected:text-indigo"
      >
        {t.label}
      </button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <div
      role="tabpanel"
      id={`${uid}-panel-${t.id}`}
      aria-labelledby={`${uid}-tab-${t.id}`}
      tabindex="0"
      hidden={i !== 0}
      class="prose-brand py-4"
      set:html={t.content}
    />
  ))}
</div>
<script>
  function initTabs(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (idx: number, focus = true) => {
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === idx));
        t.tabIndex = i === idx ? 0 : -1;
        panels[i]!.hidden = i !== idx;
      });
      if (focus) tabs[idx]?.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, false));
      t.addEventListener('keydown', (e) => {
        const map: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (e.key in map) {
          e.preventDefault();
          select(map[e.key]!);
        }
      });
    });
  }
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(initTabs);
</script>
