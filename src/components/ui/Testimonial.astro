---
interface Props {
  quote: string;
  name: string;
  role?: string;
  class?: string;
}
const { quote, name, role, class: className = '' } = Astro.props;
---

<figure class={`testimonial rounded-card bg-sand p-6 ${className}`}>
  <blockquote class="font-display text-h4 text-indigo">“{quote}”</blockquote>
  <figcaption class="mt-3 text-small text-stone-dark">
    <span class="font-medium text-charcoal">{name}</span>
    {role && <span>, {role}</span>}
  </figcaption>
</figure>
