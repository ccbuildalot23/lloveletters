---
/**
 * Toast region. Fire with: window.dispatchEvent(new CustomEvent('toast', {detail:{message, kind}}))
 * or import { toast } from '@/scripts/toast'. Rendered once in BaseLayout.
 */
---

<div
  id="toast-region"
  class="pointer-events-none fixed inset-x-0 bottom-4 z-[60] flex flex-col items-center gap-2 px-4"
  aria-live="polite"
  aria-atomic="false"
></div>
<template id="toast-template">
  <div
    class="toast pointer-events-auto flex max-w-md items-start gap-3 rounded-card bg-charcoal px-4 py-3 text-small text-white shadow-elevation anim-rise"
    role="status"
  >
    <span class="toast-message"></span>
    <button
      type="button"
      class="toast-close ml-auto -mr-1 rounded p-1 hover:bg-white/10"
      aria-label="Dismiss"
    >
      ✕
    </button>
  </div>
</template>
<script>
  import { initToasts } from '@/scripts/toast';
  initToasts();
</script>
