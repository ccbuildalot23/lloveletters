---
/** Desktop mega menu for "Shop rugs" (4.3). Opens on click/Enter; closes on Esc/outside click. */
import { megaColumns } from '@lib/nav';
import { byNewest } from '@lib/catalog';
import { imageUrl } from '@lib/images';
import Icon from '../ui/Icon.astro';
const latest = byNewest[0];
const latestImg = latest?.images.find((i) => i.kind === 'room') ?? latest?.images[0];
---

<div class="relative" data-mega>
  <button
    type="button"
    class="nav-link inline-flex min-h-[44px] items-center gap-1 rounded-btn px-3 text-body font-medium text-indigo hover:bg-sand aria-expanded:bg-sand"
    aria-expanded="false"
    aria-controls="mega-shop"
    data-mega-trigger
  >
    Shop rugs <Icon name="chevron-down" size={20} />
  </button>
  <div
    id="mega-shop"
    class="absolute top-full left-1/2 z-40 mt-2 hidden w-[min(960px,calc(100vw-48px))] -translate-x-1/2 rounded-card border border-line bg-ivory p-6 shadow-elevation data-[open]:block"
    data-mega-panel
  >
    <div class="grid grid-cols-5 gap-6">
      {megaColumns.map((col) => (
        <div>
          <h3 class="mb-2 font-sans text-small font-semibold tracking-wide text-stone uppercase">
            {col.title}
          </h3>
          <ul class="flex flex-col">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="block rounded-btn px-2 py-1.5 text-body text-charcoal no-underline hover:bg-sand hover:text-madder"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      {latest && latestImg && (
        <a
          href={`/rugs/${latest.slug}`}
          class="group block overflow-hidden rounded-card bg-sand no-underline"
        >
          <img
            src={imageUrl(latestImg.id, 'card')}
            alt={latestImg.alt}
            width="400"
            height="300"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-page ease-brand group-hover:scale-[1.02]"
          />
          <div class="p-3">
            <p class="text-caption font-medium tracking-wide text-madder uppercase">Latest drop</p>
            <p class="text-small font-medium text-indigo">
              {latest.title.replace('SAMPLE · ', '')}
            </p>
          </div>
        </a>
      )}
    </div>
  </div>
</div>
