---
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { site } from '@lib/site';
const steps = [
  {
    icon: 'flip',
    title: '1. See the proof',
    body: `Every rug has its own ${site.provenanceReport}: the back of the rug on video, the knots counted on camera, the fiber and dye checked, and where it was made. It all lives on the product page before you spend a dollar.`,
  },
  {
    icon: 'duties',
    title: '2. Order at one honest price',
    body: 'The price you see is the price. No haggling, no “was $5,000” markdowns, no surprise fees at the door. Duties and US shipping are included.',
  },
  {
    icon: 'returns',
    title: '3. Live with it at home',
    body: `It ships to your door with a signed certificate that matches its page. You get ${site.returnsDays} days to live with it. If it isn’t what the report says, it comes back.`,
  },
];
---

<section class="container-content section-pad" aria-labelledby="verify-title">
  <SectionHeader
    id="verify-title"
    eyebrow="No haggling. No surprises."
    title="Three steps to a rug you can trust"
    intro="Most people get burned buying rugs because nobody shows them the back. So I show you the back. I turn every rug over on camera, count the knots, check the fiber and the dye, and sign a certificate with its photo, size, fibers, region and age. Then you decide."
  />
  <ol class="grid gap-8 md:grid-cols-3">
    {steps.map((s) => (
      <li class="flex flex-col gap-3 rounded-card bg-sand p-6">
        <Icon name={s.icon} size={40} class="text-madder" />
        <h3 class="font-sans text-h4 font-semibold text-indigo">{s.title}</h3>
        <p class="text-body text-charcoal">{s.body}</p>
      </li>
    ))}
  </ol>
  <p class="mt-6">
    <a href="/authenticity" class="font-medium">
      Read the authenticity guide →
    </a>
  </p>
</section>
