---
/** Header search overlay (6.6): ARIA combobox, instant results, typo tolerance, Esc closes. */
import Modal from '../ui/Modal.astro';
import Icon from '../ui/Icon.astro';
import { POPULAR_SEARCHES } from '@lib/catalog-constants';
---

<Modal id="search-overlay" title="Search rugs and guides" size="lg">
  <form action="/search" method="get" role="search" data-search-form class="relative">
    <label for="search-input" class="visually-hidden">
      Search rugs by title, style, region, color, size, or ID
    </label>
    <div class="relative">
      <Icon name="search" size={20} class="absolute top-1/2 left-3 -translate-y-1/2 text-stone" />
      <input
        id="search-input"
        name="q"
        type="search"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="search-results"
        aria-haspopup="listbox"
        autocomplete="off"
        placeholder="Try “8x10 Oushak”, “runner”, “blue”, or “TR-0042”"
        class="min-h-[52px] w-full rounded-input border border-line bg-white py-3 pr-4 pl-10 text-body-lg text-charcoal focus:border-indigo focus:outline-none"
        data-search-input
      />
    </div>
    <div
      id="search-results"
      role="listbox"
      aria-label="Search results"
      class="mt-3"
      data-search-results
    ></div>
    <div class="mt-3 text-small text-stone" data-search-empty>
      <p class="font-medium text-charcoal">Popular searches</p>
      <ul class="mt-1 flex flex-wrap gap-2">
        {POPULAR_SEARCHES.map((s) => (
          <li>
            <button
              type="button"
              class="rounded-full border border-line px-3 py-1.5 text-small hover:border-indigo"
              data-search-suggest={s}
            >
              {s}
            </button>
          </li>
        ))}
      </ul>
      <p class="mt-3">
        Not finding it? <a href="/book">Book a live look</a> and I’ll pull options for you.
      </p>
    </div>
    <p class="visually-hidden" aria-live="polite" data-search-status></p>
    <button type="submit" class="visually-hidden">
      See all results
    </button>
  </form>
</Modal>
<script>
  import { initSearchOverlay } from '@/scripts/search';
  initSearchOverlay();
</script>
