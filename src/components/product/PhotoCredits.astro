---
/** Attribution for stock/sample photography (Unsplash License). Renders nothing when images carry no credit. */
interface Props {
  images: Array<{ credit?: { name: string; url: string; source?: string; photoUrl?: string } }>;
  class?: string;
  label?: string;
}
const { images, class: className = '', label = 'Sample photography' } = Astro.props;
const seen = new Map<string, { name: string; url: string; source?: string }>();
for (const img of images)
  if (img.credit && !seen.has(img.credit.name)) seen.set(img.credit.name, img.credit);
const credits = [...seen.values()];
---

{credits.length > 0 && (
  <p class={`text-caption text-stone ${className}`}>
    {label}:{' '}
    {credits.map((c, i) => (
      <>
        <a href={c.url} rel="noopener nofollow" target="_blank" class="text-stone">
          {c.name}
        </a>
        {i < credits.length - 1 ? ', ' : ''}
      </>
    ))}{' '}
    on{' '}
    <a
      href="https://unsplash.com/?utm_source=provenant_rugs&utm_medium=referral"
      rel="noopener nofollow"
      target="_blank"
      class="text-stone"
    >
      Unsplash
    </a>
    . Replace with your own photos before launch.
  </p>
)}
