---
/** 7.4 purchase panel, in the specified order, plus 7.5 button states. */
import Badge from '../ui/Badge.astro';
import PriceTag from '../ui/PriceTag.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import NotifyForm from '../forms/NotifyForm.astro';
import { sizeFt, sizeCm, isNew } from '@lib/format';
import { site, isWaitlistMode, whatsappLink } from '@lib/site';
import type { Product } from '@lib/schema';
interface Props {
  rug: Product;
}
const { rug } = Astro.props;
const title = rug.title.replace('SAMPLE · ', '');
---

<div
  class="purchase-panel flex flex-col gap-4"
  data-purchase
  data-rug-id={rug.id}
  data-status={rug.status}
>
  <div class="flex flex-wrap gap-1">
    {rug.sample && <Badge kind="sample">Sample data</Badge>}
    <Badge kind="one-of-one" />
    {isNew(rug.dateAdded) && <Badge kind="new" />}
    {rug.condition !== 'new' && <Badge kind={rug.condition} />}
  </div>
  <h1 class="text-h2">{title}</h1>
  <p class="tnum text-small text-stone">
    Rug ID <span class="font-medium text-charcoal">{rug.id}</span>
  </p>
  <div class="flex flex-wrap items-center gap-3">
    <p class="tnum text-body-lg text-charcoal">
      <span data-ft>{sizeFt(rug.sizeFt.w, rug.sizeFt.l)}</span>
      <span data-cm hidden>
        {sizeCm(rug.sizeCm.w, rug.sizeCm.l)}
      </span>
    </p>
    <div
      class="inline-flex rounded-btn border border-line p-0.5"
      role="group"
      aria-label="Units"
      data-unit-toggle
    >
      <button
        type="button"
        data-unit="ft"
        aria-pressed="true"
        class="rounded px-2 py-0.5 text-caption aria-pressed:bg-indigo aria-pressed:text-ivory"
      >
        ft
      </button>
      <button
        type="button"
        data-unit="cm"
        aria-pressed="false"
        class="rounded px-2 py-0.5 text-caption aria-pressed:bg-indigo aria-pressed:text-ivory"
      >
        cm
      </button>
    </div>
  </div>
  <PriceTag
    priceUsd={rug.priceUsd}
    dutiesIncluded={rug.dutiesIncluded}
    status={rug.status}
    size="lg"
    showBnpl
  />
  <p class="text-small text-charcoal">
    <span class="font-medium">Fiber content:</span> {rug.fiberContentLabel} Imported from Turkey.
    Sold by {site.dealerName}.
  </p>

  <p
    class="availability flex items-center gap-2 text-body font-medium"
    aria-live="polite"
    data-availability
  >
    {rug.status === 'available' ? (
      <>
        <span class="size-2.5 rounded-full bg-olive" aria-hidden="true"></span>
        <span class="text-olive-dark" data-availability-text>
          Available — one of one
        </span>
      </>
    ) : rug.status === 'reserved' ? (
      <>
        <span class="size-2.5 rounded-full bg-saffron" aria-hidden="true"></span>
        <span class="text-charcoal" data-availability-text>
          In someone’s cart — check back in 30 min
        </span>
      </>
    ) : (
      <>
        <span class="size-2.5 rounded-full bg-charcoal" aria-hidden="true"></span>
        <span class="text-charcoal" data-availability-text>
          Sold
        </span>
      </>
    )}
  </p>

  <div class="flex flex-col gap-3" data-cta-anchor>
    {isWaitlistMode ? (
      <div class="rounded-card bg-sand p-4">
        <p class="font-medium text-indigo">This rug is part of the first drop.</p>
        <p class="mt-1 text-small text-charcoal">
          Prices and checkout open to the drop list first. Join and you’ll get 48 hours of early
          access.
        </p>
        <Button href="/waitlist" class="mt-3" full>
          Join the drop list
        </Button>
      </div>
    ) : (
      <>
        <div data-cta-available hidden={rug.status !== 'available'}>
          <Button
            type="button"
            size="lg"
            full
            data-buy-now={rug.id}
            data-price={rug.priceUsd}
            loadingText="Reserving your rug…"
          >
            Buy now
          </Button>
          <Button
            type="button"
            variant="secondary"
            size="lg"
            full
            class="mt-3"
            data-add-to-cart={rug.id}
            data-price={rug.priceUsd}
          >
            Add to cart
          </Button>
          <p class="mt-2 hidden text-small text-error" data-buy-error role="alert"></p>
        </div>
        <div data-cta-reserved hidden={rug.status !== 'reserved'} id="notify">
          <p class="text-small text-charcoal">
            Someone’s checking out with this rug right now. If it frees up, I’ll email you.
          </p>
          <NotifyForm rugId={rug.id} />
        </div>
        <div data-cta-sold hidden={rug.status !== 'sold'}>
          <p class="font-medium text-indigo">This one found a home.</p>
          <Button href="#find-similar" variant="secondary" size="lg" full class="mt-2">
            Find me one like it
          </Button>
        </div>
        <noscript>
          <form method="post" action="/api/checkout">
            <input type="hidden" name="rugIds" value={rug.id} />
            <Button type="submit" size="lg" full>
              Buy now
            </Button>
          </form>
        </noscript>
      </>
    )}
    <Button
      href={`/book?rug=${rug.id}`}
      variant="ghost"
      size="lg"
      full
      data-track="book_call"
      data-track-params={JSON.stringify({ item_id: rug.id })}
    >
      Book a live video look
    </Button>
    <button
      type="button"
      class="self-start text-small text-madder underline underline-offset-4"
      data-open-modal="room-modal"
    >
      See it in my room
    </button>
  </div>

  <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-line pt-4 text-small text-charcoal">
    <li class="flex items-center gap-2">
      <Icon name="returns" size={20} class="text-olive" /> 30-day returns
    </li>
    <li class="flex items-center gap-2">
      <Icon name="certificate" size={20} class="text-olive" /> Signed certificate
    </li>
    <li class="flex items-center gap-2">
      <Icon name="lock" size={20} class="text-olive" /> Secure checkout
    </li>
    <li class="flex items-center gap-2">
      <Icon name="whatsapp" size={20} class="text-olive" />{' '}
      <a href={whatsappLink(`Hi, I'm interested in rug ${rug.id}`)} rel="noopener">
        Text/WhatsApp {site.phone}
      </a>
    </li>
  </ul>
</div>
